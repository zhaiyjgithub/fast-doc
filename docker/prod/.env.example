# Copy to docker/prod/.env on the server and replace every CHANGE_ME value.
# Never commit docker/prod/.env.

# API
API_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true
LOG_REQUESTS=true
LOG_EXCLUDE_PATHS=/health
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_TENANT_ID=
LOKI_TIMEOUT_SECONDS=2.0

# PostgreSQL
POSTGRES_USER=fastdoc
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
POSTGRES_DB=fastdoc

# Qwen / DashScope
QWEN_API_KEY=CHANGE_ME
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_VL_MODEL=qwen-vl-max
EMBEDDING_DIM=1024

# MinerU
MINERU_API_KEY=CHANGE_ME
MINERU_SINGLE_URL=https://mineru.net/api/v4/extract/task
MINERU_BATCH_UPLOAD_URL=https://mineru.net/api/v4/file-urls/batch
MINERU_SINGLE_POLL_URL=https://mineru.net/api/v4/extract/task/{task_id}
MINERU_BATCH_POLL_URL=https://mineru.net/api/v4/extract-results/batch/{batch_id}
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=en
MINERU_POLL_INTERVAL=10
MINERU_MAX_WAIT=900

# Security
# ENCRYPTION_KEY must be base64 for exactly 32 random bytes:
# python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=7

# Feature flags
IMAGE_DESCRIPTION_ENABLED=true
